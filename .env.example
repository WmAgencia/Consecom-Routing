# =============================================================================
# Consecom Routing — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit secrets.

# ---------- Database (Neon Postgres) ----------
# Get from https://console.neon.tech after creating a project
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/consecom_dev?sslmode=require

# ---------- Server ----------
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---------- Auth (JWT) ----------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-prod-use-openssl-rand-hex-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ---------- Master Encryption Key ----------
# Used to encrypt provider API keys (AES-256-GCM / HKDF).
# Generate with: openssl rand -hex 32
# NEVER use the dev default in production — the API refuses to boot.
MASTER_ENCRYPTION_KEY=dev-only-do-not-use-in-production-00000000000000000000

# ---------- Stripe ----------
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_TESTE=price_xxx

# ---------- Anthropic (provider) ----------
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxx

# ---------- CORS ----------
# Comma-separated list of allowed origins for the public API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Logging ----------
LOG_LEVEL=info
