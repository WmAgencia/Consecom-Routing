{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && cd apps/web && next build",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://api.consecom.com.br/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.consecom.com.br/health"
    }
  ]
}