{
  "name": "consecom-ai-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "build:vercel": "node scripts/build-vercel.mjs",
    "validate": "node scripts/validate-repository.mjs",
    "check:services": "node scripts/check-services.mjs",
    "migrate": "bun run scripts/migrate.ts",
    "check": "npm run validate && npm run check:services",
    "smoke:public": "node scripts/smoke-public.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}

