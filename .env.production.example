# =============================================================================
# Consecom Routing — Production Environment Variables
# =============================================================================
# These vars are set in the Railway dashboard per-service. NEVER commit real
# secrets. .env.local is for local dev only and is gitignored.
# =============================================================================

# ---------- API service (apps/api) on Railway ----------
# DATABASE_URL           = (set via Railway Postgres plugin reference)
# JWT_SECRET             = openssl rand -base64 32
# MASTER_ENCRYPTION_KEY  = openssl rand -hex 32
# ANTHROPIC_API_KEY      = sk-ant-...
# ANTHROPIC_BASE_URL     = https://api.anthropic.com
# PUBLIC_API_URL         = https://api.routing.consecom.com.br
# PUBLIC_WEB_URL         = https://routing.consecom.com.br
# COOKIE_DOMAIN          = .routing.consecom.com.br   (omit leading dot for modern browsers)
# COOKIE_SECURE          = true
# API_PORT               = 3001
# CORS_ALLOWED_ORIGINS   = https://routing.consecom.com.br
# LOG_LEVEL              = info
# NODE_ENV               = production
# STRIPE_SECRET_KEY      = sk_live_...
# STRIPE_WEBHOOK_SECRET  = whsec_...
# STRIPE_PRICE_ID_STARTER    = price_...
# STRIPE_PRICE_ID_PRO        = price_...
# STRIPE_PRICE_ID_POWER      = price_...
# STRIPE_PRICE_ID_ENTERPRISE = price_...
# JWT_ACCESS_TTL_SECONDS     = 900
# JWT_REFRESH_TTL_SECONDS    = 604800

# ---------- Web service (apps/web) on Railway ----------
# PUBLIC_API_URL         = https://api.routing.consecom.com.br
#                          (used by Next.js rewrites for browser /v1/* traffic)
# API_URL                = http://api.railway.internal:3001
#                          (used by Next.js Route Handler proxy at /api/admin/proxy;
#                           talks to the API over Railway's private network)
# NEXT_PUBLIC_API_URL    = https://api.routing.consecom.com.br
#                          (anything exposed to the browser must use NEXT_PUBLIC_)
# NEXT_PUBLIC_WEB_URL    = https://routing.consecom.com.br
# NODE_ENV               = production
# PORT                   = 3000   (Railway injects automatically)
