{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [],
  "rewrites": [
    {
      "source": "/comprar",
      "destination": "https://consecom-checkout-production.up.railway.app/comprar"
    },
    {
      "source": "/cadastro",
      "destination": "https://consecom-checkout-production.up.railway.app/comprar"
    },
    {
      "source": "/checkout",
      "destination": "https://consecom-checkout-production.up.railway.app/comprar"
    },
    {
      "source": "/sucesso",
      "destination": "https://consecom-checkout-production.up.railway.app/sucesso"
    },
    {
      "source": "/api/start",
      "destination": "https://consecom-checkout-production.up.railway.app/api/start"
    },
    {
      "source": "/api/cancel",
      "destination": "https://consecom-checkout-production.up.railway.app/api/cancel"
    },
    {
      "source": "/api/order",
      "destination": "https://consecom-checkout-production.up.railway.app/api/order"
    },
    {
      "source": "/api/reveal",
      "destination": "https://consecom-checkout-production.up.railway.app/api/reveal"
    },
    {
      "source": "/api/status",
      "destination": "https://consecom-checkout-production.up.railway.app/api/status"
    },
    {
      "source": "/login",
      "destination": "https://consecom-ai-portal-production.up.railway.app/login"
    },
    {
      "source": "/admin",
      "destination": "https://consecom-ai-portal-production.up.railway.app/admin"
    },
    {
      "source": "/cliente",
      "destination": "https://consecom-ai-portal-production.up.railway.app/cliente"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://consecom-ai-portal-production.up.railway.app/auth/:path*"
    },
    {
      "source": "/api/client/:path*",
      "destination": "https://consecom-ai-portal-production.up.railway.app/api/client/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://consecom-ai-portal-production.up.railway.app/api/admin/:path*"
    },
    {
      "source": "/api/account/:path*",
      "destination": "https://consecom-ai-portal-production.up.railway.app/api/account/:path*"
    },
    {
      "source": "/api/me",
      "destination": "https://consecom-ai-portal-production.up.railway.app/api/me"
    }
  ]
}
